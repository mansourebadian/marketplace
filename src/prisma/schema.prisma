generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  phone         String?   @db.NVarChar(32)
  name          String?
  firstName     String?   @db.NVarChar(100)
  lastName      String?   @db.NVarChar(100)
  email         String    @unique @db.NVarChar(320)
  emailVerified DateTime?
  image         String?   @db.NVarChar(2048)
  country       String?   @db.NVarChar(100)
  passwordHash  String?   @db.NVarChar(255)
  dateOfBirth   DateTime? @db.Date
  gender        String?   @db.NVarChar(32)
  role          String    @default("CUSTOMER") // CUSTOMER, OWNER, ADMIN
  accounts      Account[]
  sessions      Session[]
  addresses     CustomerAddress[]
  bookings      Booking[]
  reviews       Review[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model CustomerAddress {
  id          String   @id @default(cuid()) @db.NVarChar(36)
  label       String   @db.NVarChar(16) // HOME, WORK
  addressLine String   @db.NVarChar(300)
  city        String?  @db.NVarChar(100)
  province    String?  @db.NVarChar(100)
  postalCode  String?  @db.NVarChar(20)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, label])
}

model Account {
  id                String  @id @default(cuid()) @db.NVarChar(36)
  userId            String
  type              String  @db.NVarChar(32)
  provider          String  @db.NVarChar(64)
  providerAccountId String  @db.NVarChar(255)
  refresh_token     String? @db.NVarChar(Max)
  access_token      String? @db.NVarChar(Max)
  expires_at        Int?
  token_type        String? @db.NVarChar(64)
  scope             String? @db.NVarChar(Max)
  id_token          String? @db.NVarChar(Max)
  session_state     String? @db.NVarChar(255)
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid()) @db.NVarChar(36)
  sessionToken String   @unique @db.NVarChar(255)
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
}

model VerificationToken {
  identifier String   @db.NVarChar(320)
  token      String   @unique @db.NVarChar(255)
  expires    DateTime

  @@unique([identifier, token])
}

model Salon {
  id           String   @id @default(cuid())
  name         String
  address      String
  lat          Float
  lng          Float
  description  String?
  imageUrl     String?
  priceRange   String?
  rating       Float?   @default(0) // این فیلد جا افتاده است
  reviewsCount Int?     @default(0) // این فیلد جا افتاده است
  createdAt    DateTime @default(now())

  // Relations
  services    Service[]
  teamMembers TeamMember[]
  portfolio   Portfolio[]
  reviews     Review[]
  bookings    Booking[]
}

model Service {
  id          String           @id @default(uuid())
  name        String
  price       Int
  durationMin Int // مدت زمان خدمت به دقیقه
  salonId     String
  salon       Salon            @relation(fields: [salonId], references: [id])
  categoryId  String?
  category    ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bookings    Booking[]
}

model ServiceCategory {
  id        String    @id @default(cuid())
  name      String // نام دسته‌بندی (مثلا: مو و آرایش مو)
  slug      String    @unique
  icon      String // نام آیکون lucide (مثلا: Scissors)
  order     Int       @default(0) // ترتیب نمایش در لیست
  services  Service[]
  createdAt DateTime  @default(now())
}

model TeamMember {
  id        String    @id @default(uuid())
  name      String
  role      String
  avatarUrl String?
  salonId   String
  salon     Salon     @relation(fields: [salonId], references: [id])
  bookings  Booking[]
}

model Booking {
  id     String   @id @default(uuid())
  date   DateTime // تاریخ و زمان رزرو
  status String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED

  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  salonId      String
  salon        Salon      @relation(fields: [salonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  serviceId    String
  service      Service    @relation(fields: [serviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teamMemberId String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Review {
  id      String   @id @default(uuid())
  rating  Int
  comment String?
  date    DateTime @default(now())
  userId  String
  user    User     @relation(fields: [userId], references: [id])
  salonId String
  salon   Salon    @relation(fields: [salonId], references: [id])
}

model Portfolio {
  id       String  @id @default(cuid())
  imageUrl String
  caption  String?
  order    Int     @default(0) // این فیلد اضافه شد

  // Relation to Salon
  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
