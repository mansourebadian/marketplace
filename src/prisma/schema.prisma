generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id            String            @id @default(uuid())
  phone         String?           @db.NVarChar(32)
  name          String?
  firstName     String?           @db.NVarChar(100)
  lastName      String?           @db.NVarChar(100)
  email         String            @unique @db.NVarChar(320)
  emailVerified DateTime?
  image         String?           @db.NVarChar(2048)
  country       String?           @db.NVarChar(100)
  passwordHash  String?           @db.NVarChar(255)
  dateOfBirth   DateTime?         @db.Date
  gender        String?           @db.NVarChar(32)
  role          String            @default("CUSTOMER") // CUSTOMER, OWNER, ADMIN
  accounts      Account[]
  sessions      Session[]
  addresses     CustomerAddress[]
  bookings      Booking[]
  reviews       Review[]
  business      Business?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model CustomerAddress {
  id          String   @id @default(cuid()) @db.NVarChar(36)
  label       String   @db.NVarChar(16) // HOME, WORK
  addressLine String   @db.NVarChar(300)
  city        String?  @db.NVarChar(100)
  province    String?  @db.NVarChar(100)
  postalCode  String?  @db.NVarChar(20)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, label])
}

model Account {
  id                String  @id @default(cuid()) @db.NVarChar(36)
  userId            String
  type              String  @db.NVarChar(32)
  provider          String  @db.NVarChar(64)
  providerAccountId String  @db.NVarChar(255)
  refresh_token     String? @db.NVarChar(Max)
  access_token      String? @db.NVarChar(Max)
  expires_at        Int?
  token_type        String? @db.NVarChar(64)
  scope             String? @db.NVarChar(Max)
  id_token          String? @db.NVarChar(Max)
  session_state     String? @db.NVarChar(255)
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid()) @db.NVarChar(36)
  sessionToken String   @unique @db.NVarChar(255)
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
}

model VerificationToken {
  identifier String   @db.NVarChar(320)
  token      String   @unique @db.NVarChar(255)
  expires    DateTime

  @@unique([identifier, token])
}

model PhoneChallenge {
  id          String    @id @db.NVarChar(64)
  phone       String    @db.NVarChar(32)
  codeHash    String    @db.NVarChar(64)
  requestKey  String    @db.NVarChar(64)
  flow        String    @db.NVarChar(16)
  callbackUrl String    @db.NVarChar(2048)
  attempts    Int       @default(0)
  delivered   Boolean   @default(false)
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime

  @@index([phone, createdAt])
  @@index([requestKey, createdAt])
}

model Salon {
  id           String   @id @default(cuid())
  name         String
  address      String
  lat          Float
  lng          Float
  description  String?
  imageUrl     String?
  priceRange   String?
  rating       Float?   @default(0)
  reviewsCount Int?     @default(0)
  createdAt    DateTime @default(now())

  // Relations
  services    Service[]
  teamMembers TeamMember[]
  portfolio   Portfolio[]
  reviews     Review[]
  bookings    Booking[]
}

model Service {
  id          String           @id @default(uuid())
  name        String
  price       Int
  durationMin Int
  salonId     String
  salon       Salon            @relation(fields: [salonId], references: [id])
  categoryId  String?
  category    ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bookings    Booking[]
}

model ServiceCategory {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  icon      String
  order     Int       @default(0)
  services  Service[]
  createdAt DateTime  @default(now())
}

model TeamMember {
  id        String    @id @default(uuid())
  name      String
  role      String
  avatarUrl String?
  salonId   String
  salon     Salon     @relation(fields: [salonId], references: [id])
  bookings  Booking[]
}

model Booking {
  id     String   @id @default(uuid())
  date   DateTime
  status String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED

  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  salonId      String
  salon        Salon      @relation(fields: [salonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  serviceId    String
  service      Service    @relation(fields: [serviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teamMemberId String
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Review {
  id      String   @id @default(uuid())
  rating  Int
  comment String?
  date    DateTime @default(now())
  userId  String
  user    User     @relation(fields: [userId], references: [id])
  salonId String
  salon   Salon    @relation(fields: [salonId], references: [id])
}

model Portfolio {
  id       String  @id @default(cuid())
  imageUrl String
  caption  String?
  order    Int     @default(0)

  // Relation to Salon
  salonId String
  salon   Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Business {
  teamSize         String?                     @db.NVarChar(32)
  serviceLocation  String?                     @db.NVarChar(256)
  previousSoftware String?                     @db.NVarChar(64)
  businessLocation String?                     @db.NVarChar(300)
  businessAddress  String?                     @db.NVarChar(1200)
  categories       BusinessCategorySelection[]
  serviceCategories BusinessServiceCategory[]
  locations        BusinessLocation[]
  id               String                      @id @default(cuid()) @db.NVarChar(36)
  name             String                      @db.NVarChar(100)
  website          String?                     @db.NVarChar(255)
  taxMode          String?                     @default("include") @db.NVarChar(16)
  teamLanguage     String?                     @db.NVarChar(32)
  clientLanguage   String?                     @db.NVarChar(32)
  rubika           String?                     @db.NVarChar(255)
  instagram        String?                     @db.NVarChar(255)
  bale             String?                     @db.NVarChar(255)
  ownerId          String                      @unique
  owner            User                        @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
}

model BusinessServiceCategory {
  id          String   @id @default(cuid()) @db.NVarChar(36)
  businessId  String   @db.NVarChar(36)
  name        String   @db.NVarChar(100)
  color       String   @db.NVarChar(20)
  description String?  @db.NVarChar(255)
  createdAt   DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([businessId])
}

model BusinessCategorySelection {
  id         String   @id @default(cuid()) @db.NVarChar(36)
  businessId String   @db.NVarChar(36)
  slug       String   @db.NVarChar(64)
  customName String?  @db.NVarChar(100)
  displayName String? @db.NVarChar(100)
  color      String   @default("blue") @db.NVarChar(20)
  description String? @db.NVarChar(255)
  position   Int
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([businessId, slug])
  @@unique([businessId, position])
}

model BusinessLocation {
  id             String                @id @default(cuid()) @db.NVarChar(36)
  businessId     String                @db.NVarChar(36)
  name           String                @db.NVarChar(60)
  internalName   String?               @db.NVarChar(60)
  phone          String?               @db.NVarChar(32)
  email          String?               @db.NVarChar(320)
  address        String?               @db.NVarChar(300)
  noFixedAddress Boolean               @default(false)
  business       Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  openingHours   LocationOpeningHour[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([businessId])
}

model LocationOpeningHour {
  id         String           @id @default(cuid()) @db.NVarChar(36)
  locationId String           @db.NVarChar(36)
  day        Int
  enabled    Boolean          @default(true)
  opensAt    String           @db.NVarChar(5)
  closesAt   String           @db.NVarChar(5)
  location   BusinessLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, day])
}
