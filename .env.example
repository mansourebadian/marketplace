# SQL Server connection string used by Prisma.
DATABASE_URL="sqlserver://localhost:1433;database=fresha;user=sa;password=change-me;trustServerCertificate=true"

# Generate a strong value with: npx auth secret
AUTH_SECRET="replace-with-a-random-secret"

# OAuth 2.0 Web Application credentials from Google Cloud Console.
AUTH_GOOGLE_ID="replace-with-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-client-secret"

# Local Google callback:
# http://localhost:3000/api/auth/callback/google
AUTH_URL="http://localhost:3000"

# Phone OTP: disabled until a provider and its credentials are configured.
# Options: kavenegar | melipayamak | twilio | webhook | console
# For local testing: SMS_PROVIDER="console" prints OTP in the server terminal.
# The console provider is allowed ONLY with NODE_ENV=development (next dev).
SMS_PROVIDER=""

# Kavenegar: approved Verify Lookup template containing the code token.
KAVENEGAR_API_KEY=""
KAVENEGAR_OTP_TEMPLATE=""

# Melipayamak: approved shared-service pattern with one parameter (the code).
MELIPAYAMAK_USERNAME=""
MELIPAYAMAK_PASSWORD=""
MELIPAYAMAK_BODY_ID=""

# Twilio: configure a sender OR a Messaging Service SID.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
TWILIO_MESSAGING_SERVICE_SID=""

# Other providers: HTTPS gateway receives {phone, code, text, expiresInSeconds}
# and must return HTTP 2xx with {"accepted":true} only when it accepts the SMS.
SMS_WEBHOOK_URL=""
SMS_WEBHOOK_TOKEN=""

# Set only to an IP header overwritten by your trusted reverse proxy.
# When unset, requests share the conservative 20 sends/hour source limit.
OTP_TRUSTED_IP_HEADER=""
